{
  // IA Suite — installazione IA International Advisors S.r.l.
  "name": "ia-suite-srl",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // Nessun indirizzo tecnico *.workers.dev: si entra solo dal dominio protetto
  "workers_dev": false,
  "preview_urls": false,

  "routes": [
    { "pattern": "srl-suite.ia-advisors-hub.com", "custom_domain": true }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Spazio dati riservato alla S.r.l.
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "ia-suite-srl-data" }
  ],

  "vars": {
    "ENTITY": "srl",
    "ANTHROPIC_MODEL": "claude-sonnet-5"
  }
  // ANTHROPIC_API_KEY va impostata come "Secret" nel pannello Cloudflare
}
